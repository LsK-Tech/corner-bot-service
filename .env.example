CORNER_BET_USERNAME=
CORNER_BET_PASSWORD=
# Target REST API to persist game compact payload (implement on your backend)
# Base URL only; the client sends PUT to {base}/api/soccer-stats
GAME_COMPACT_API_URL=https://seu-dominio.com
GAME_COMPACT_API_TOKEN=
